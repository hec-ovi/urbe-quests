    "mechanicTargetBindings": {
      "$ref": "https://urbe.local/quests/handoff/schema/mechanic-target-bindings.schema.json"
    },
    "missionAssetRequests": {
      "$ref": "https://urbe.local/quests/handoff/schema/mission-asset-requests.schema.json"
    },
    "missionItemBindings": {
      "$ref": "https://urbe.local/quests/handoff/schema/mission-item-bindings.schema.json"
    }
