    "hostCapabilities": {
      "$ref": "https://urbe.local/quests/handoff/schema/host-capabilities.schema.json"
    },
    "investigations": {
      "type": "array",
      "items": { "$ref": "https://urbe.local/quests/handoff/schema/investigation-binding-slice.schema.json" }
