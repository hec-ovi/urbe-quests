{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urbe.local/quests/handoff/schema/investigation-binding-slice.schema.json",
  "title": "Consumed binding slice of an engine investigation request",
  "description": "Version 1.1 measures its own location; version 1.2 stands over the scenery scene it links and shows each evidence on one of that scene's elements.",
  "oneOf": [{ "$ref": "#/$defs/measured" }, { "$ref": "#/$defs/linked" }],
  "$defs": {
    "measured": {
      "type": "object",
      "required": ["contractVersion", "sceneId", "questId", "questBindings", "location", "evidence", "props"],
      "properties": {
        "contractVersion": { "const": "1.1" },
        "sceneId": { "$ref": "#/$defs/id" },
        "questId": { "$ref": "#/$defs/id" },
        "questBindings": { "$ref": "#/$defs/questBindings" },
        "location": {
          "type": "object",
          "required": ["placeId"],
          "properties": { "placeId": { "$ref": "#/$defs/id" } }
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "props": { "type": "array" }
      }
    },
    "linked": {
      "type": "object",
      "required": ["contractVersion", "sceneId", "questId", "questBindings", "scenery", "evidenceVisuals", "evidence"],
      "properties": {
        "contractVersion": { "const": "1.2" },
        "sceneId": { "$ref": "#/$defs/id" },
        "questId": { "$ref": "#/$defs/id" },
        "questBindings": { "$ref": "#/$defs/questBindings" },
        "scenery": {
          "type": "object",
          "required": ["sceneId"],
          "properties": { "sceneId": { "$ref": "#/$defs/id" } }
        },
        "evidenceVisuals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["evidenceId", "entityId"],
            "properties": { "evidenceId": { "$ref": "#/$defs/id" }, "entityId": { "$ref": "#/$defs/id" } }
          }
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "id": { "type": "string", "minLength": 1 },
    "place": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["parcelId"], "properties": { "parcelId": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["districtId"], "properties": { "districtId": { "$ref": "#/$defs/id" } } }
      ]
    },
    "questBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepId", "evidenceId", "place", "completionAction"],
        "properties": {
          "stepId": { "$ref": "#/$defs/id" },
          "evidenceId": { "$ref": "#/$defs/id" },
          "place": { "$ref": "#/$defs/place" },
          "completionAction": { "enum": ["inspect", "take"] }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidenceId", "factId", "portable", "prerequisiteEvidenceIds"],
        "properties": {
          "evidenceId": { "$ref": "#/$defs/id" },
          "factId": { "$ref": "#/$defs/id" },
          "portable": { "type": "boolean" },
          "prerequisiteEvidenceIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        }
      }
    }
  }
}
