{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urbe.local/quests/flow/schema/player-event.schema.json",
  "title": "PlayerEvent",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "npcId"],
      "properties": { "kind": { "const": "talkedTo" }, "npcId": { "$ref": "#/$defs/id" } }
    },
    {
      "oneOf": [
        { "$ref": "#/$defs/arrivedAtParcel" },
        { "$ref": "#/$defs/arrivedAtDistrict" },
        { "$ref": "#/$defs/arrivedAtStation" },
        { "$ref": "#/$defs/arrivedAtStop" }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "districtId"],
      "properties": { "kind": { "const": "observed" }, "districtId": { "$ref": "#/$defs/id" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "itemId"],
      "properties": { "kind": { "const": "pickedUp" }, "itemId": { "$ref": "#/$defs/id" } }
    },
    {
      "oneOf": [
        { "$ref": "#/$defs/deliveredAtParcel" },
        { "$ref": "#/$defs/deliveredAtDistrict" },
        { "$ref": "#/$defs/deliveredAtStation" },
        { "$ref": "#/$defs/deliveredAtStop" }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "npcIds"],
      "properties": {
        "kind": { "const": "overheard" },
        "npcIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "itemId"],
      "properties": { "kind": { "const": "stole" }, "itemId": { "$ref": "#/$defs/id" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "npcId"],
      "properties": { "kind": { "const": "killed" }, "npcId": { "$ref": "#/$defs/id" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "parcelId"],
      "properties": { "kind": { "const": "workedShift" }, "parcelId": { "$ref": "#/$defs/id" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sceneId", "evidenceId", "place"],
      "properties": {
        "kind": { "const": "investigated" },
        "sceneId": { "$ref": "#/$defs/id" },
        "evidenceId": { "$ref": "#/$defs/id" },
        "place": { "$ref": "#/$defs/place" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "npcId", "releaseTargetId", "place"],
      "properties": {
        "kind": { "const": "released" },
        "npcId": { "$ref": "#/$defs/id" },
        "releaseTargetId": { "$ref": "#/$defs/id" },
        "place": { "$ref": "#/$defs/place" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "npcId", "routeId", "mode", "from", "to"],
      "properties": {
        "kind": { "const": "escorted" },
        "npcId": { "$ref": "#/$defs/id" },
        "routeId": { "$ref": "#/$defs/id" },
        "mode": { "enum": ["follow-player", "lead-player"] },
        "from": { "$ref": "#/$defs/place" },
        "to": { "$ref": "#/$defs/place" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "accessPointId", "credentialItemId", "place"],
      "properties": {
        "kind": { "const": "accessed" },
        "accessPointId": { "$ref": "#/$defs/id" },
        "credentialItemId": { "$ref": "#/$defs/id" },
        "place": { "$ref": "#/$defs/place" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetId", "place"],
      "properties": { "kind": { "const": "hacked" }, "targetId": { "$ref": "#/$defs/id" }, "place": { "$ref": "#/$defs/place" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetId", "place"],
      "properties": { "kind": { "const": "sabotaged" }, "targetId": { "$ref": "#/$defs/id" }, "place": { "$ref": "#/$defs/place" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "journeyId", "mode", "from", "to", "passengerNpcIds", "cargoItemIds"],
      "properties": {
        "kind": { "const": "transported" },
        "journeyId": { "$ref": "#/$defs/id" },
        "mode": { "enum": ["ride-hail", "public-transit", "vehicle", "animal", "aircraft"] },
        "from": { "$ref": "#/$defs/place" },
        "to": { "$ref": "#/$defs/place" },
        "passengerNpcIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "cargoItemIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "place": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["parcelId"],
          "properties": { "parcelId": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["districtId"],
          "properties": { "districtId": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stationId"],
          "properties": { "stationId": { "$ref": "#/$defs/id" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["stopId"],
          "properties": { "stopId": { "$ref": "#/$defs/id" } }
        }
      ]
    },
    "arrivedAtParcel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "parcelId"],
      "properties": { "kind": { "const": "arrivedAt" }, "parcelId": { "$ref": "#/$defs/id" } }
    },
    "arrivedAtDistrict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "districtId"],
      "properties": { "kind": { "const": "arrivedAt" }, "districtId": { "$ref": "#/$defs/id" } }
    },
    "arrivedAtStation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stationId"],
      "properties": { "kind": { "const": "arrivedAt" }, "stationId": { "$ref": "#/$defs/id" } }
    },
    "arrivedAtStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stopId"],
      "properties": { "kind": { "const": "arrivedAt" }, "stopId": { "$ref": "#/$defs/id" } }
    },
    "deliveredAtParcel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "itemId", "parcelId"],
      "properties": { "kind": { "const": "delivered" }, "itemId": { "$ref": "#/$defs/id" }, "parcelId": { "$ref": "#/$defs/id" } }
    },
    "deliveredAtDistrict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "itemId", "districtId"],
      "properties": { "kind": { "const": "delivered" }, "itemId": { "$ref": "#/$defs/id" }, "districtId": { "$ref": "#/$defs/id" } }
    },
    "deliveredAtStation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "itemId", "stationId"],
      "properties": { "kind": { "const": "delivered" }, "itemId": { "$ref": "#/$defs/id" }, "stationId": { "$ref": "#/$defs/id" } }
    },
    "deliveredAtStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "itemId", "stopId"],
      "properties": { "kind": { "const": "delivered" }, "itemId": { "$ref": "#/$defs/id" }, "stopId": { "$ref": "#/$defs/id" } }
    }
  }
}
