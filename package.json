{
  "name": "quests",
  "version": "0.8.4",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-prompts.mjs",
    "watch": "npm run build && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "sample": "node --import tsx creation/samples/run-local.ts",
    "replay": "node --import tsx creation/samples/replay.ts",
    "bundle": "node --import tsx creation/samples/bundle.ts",
    "materialize": "node --import tsx creation/samples/materialize.ts"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "undici": "^8.10.1",
    "vitest": "^4.1.11"
  }
}
