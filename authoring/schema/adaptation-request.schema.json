{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urbe:quests:authoring:adaptation-request",
  "type": "object",
  "additionalProperties": false,
  "required": ["story", "world", "types"],
  "properties": {
    "story": { "$ref": "urn:urbe:quests:authoring:story-output" },
    "world": { "$ref": "urn:urbe:quests:authoring:world-context#/properties/world" },
    "types": { "$ref": "urn:urbe:quests:authoring:world-context#/properties/types" },
    "requestedMechanics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:urbe:quests:authoring:values#/$defs/id" }
    }
  }
}
